{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:senvoryn:schema:operation-registry:1.0",
  "title": "Senvoryn Trusted Operation Registry Entry Set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "registry_id", "registry_epoch", "operations", "signature_ref"],
  "properties": {
    "schema": {"const": "senvoryn.operation-registry.v1"},
    "registry_id": {"type": "string", "minLength": 3},
    "registry_epoch": {"type": "integer", "minimum": 0},
    "operations": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["operation_id", "resource_types", "risk_tier", "reversibility", "approval_requirements", "external_effects", "allowed_modes", "idempotent", "max_duration_ms"],
        "properties": {
          "operation_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,95}$"},
          "resource_types": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "risk_tier": {"type": "string", "enum": ["R0", "R1", "R2", "R3"]},
          "reversibility": {"type": "string", "enum": ["REVERSIBLE", "COMPENSATABLE", "NON_REVERSIBLE", "UNKNOWN"]},
          "approval_requirements": {"type": "array", "items": {"type": "string", "enum": ["NONE", "USER_CONFIRMATION", "STRONG_AUTH", "TWO_PERSON"]}, "uniqueItems": true},
          "external_effects": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "allowed_modes": {"type": "array", "items": {"type": "string", "enum": ["NORMAL", "DEGRADED", "READ_ONLY", "RECOVERY", "QUARANTINED", "MAINTENANCE", "OFFLINE"]}, "uniqueItems": true},
          "idempotent": {"type": "boolean"},
          "max_duration_ms": {"type": "integer", "minimum": 1, "maximum": 604800000},
          "max_operation_count": {"type": "integer", "minimum": 1},
          "required_preconditions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "required_postconditions": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "audit_class": {"type": "string", "enum": ["STANDARD", "SENSITIVE", "SECURITY_CRITICAL"]}
        }
      }
    },
    "signature_ref": {"type": "string", "minLength": 3}
  }
}
